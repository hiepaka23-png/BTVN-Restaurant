MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/recipeapp?retryWrites=true&w=majority
PORT=3000
JWT_SECRET=<chuoi-bi-mat-cho-access-token>
JWT_REFRESH_SECRET=<chuoi-bi-mat-cho-refresh-token>
NODE_ENV=development

# Tuỳ chọn — để trống thì mã quên mật khẩu chỉ hiện demo trên UI, không gửi email thật.
GMAIL_USER=<email-gmail-dung-de-gui>
GMAIL_APP_PASSWORD=<app-password-16-ky-tu>
